# Flask Configuration
SECRET_KEY=enterprise_finance_secret_key_reconciliation_2026
FLASK_ENV=development
PORT=5000

# Database Configuration (PostgreSQL URL)
# Example for PostgreSQL: postgresql://postgres:password@localhost:5432/invoice_reconciliation
# If left as default or PostgreSQL server is not running, will gracefully fallback to SQLite for local development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invoice_reconciliation

# AI & LLM Provider Configuration
# Supported providers: gemini, openai, rule-based
LLM_PROVIDER=rule-based
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# File Upload Settings
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=backend/uploads

# Tolerance settings for matching (percentage: 0.01 = 1%, absolute: 5.0 = ₹5.00)
PRICE_TOLERANCE_PERCENT=0.01
PRICE_TOLERANCE_ABSOLUTE=5.00
